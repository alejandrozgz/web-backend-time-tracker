{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:staging": "env-cmd -f .env.staging next dev --turbopack",
    "build": "next build --turbopack",
    "build:staging": "env-cmd -f .env.staging next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "migrate:staging": "cross-env ENV_FILE=.env.staging node scripts/migrate.js",
    "migrate:staging:dry": "cross-env ENV_FILE=.env.staging node scripts/migrate.js --dry-run",
    "migrate:prod": "cross-env ENV_FILE=.env.local node scripts/migrate.js",
    "migrate:prod:dry": "cross-env ENV_FILE=.env.local node scripts/migrate.js --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "uuid": "^11.1.0",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
